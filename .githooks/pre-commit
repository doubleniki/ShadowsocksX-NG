#!/bin/bash
#
# Pre-commit hook for ShadowsocksX-NG
# Performs code quality checks before commit
#
# To enable this hook, run:
# git config core.hooksPath .githooks

set -e

echo "[*] Running pre-commit checks..."

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Check if SwiftLint is installed
if ! command -v swiftlint &> /dev/null; then
    echo -e "${YELLOW}[!] SwiftLint is not installed. Install it with: brew install swiftlint${NC}"
    echo "Skipping SwiftLint checks..."
else
    echo "[>] Running SwiftLint..."

    # Get list of staged Swift files
    SWIFT_FILES=$(git diff --cached --name-only --diff-filter=d | grep '\.swift$' || true)

    if [ -n "$SWIFT_FILES" ]; then
        # Run SwiftLint only on staged files
        if echo "$SWIFT_FILES" | xargs swiftlint lint --quiet; then
            echo -e "${GREEN}[+] SwiftLint passed${NC}"
        else
            echo -e "${RED}[-] SwiftLint found issues. Please fix them before committing.${NC}"
            exit 1
        fi
    else
        echo "No Swift files to lint"
    fi
fi

# Check for trailing whitespace
echo "[>] Checking for trailing whitespace..."
git diff-index --check --cached HEAD -- || {
    echo -e "${RED}[-] Found trailing whitespace. Please remove it.${NC}"
    exit 1
}
echo -e "${GREEN}[+] No trailing whitespace${NC}"

# Check for TODO/FIXME in staged changes (informational)
echo "[>] Checking for TODO/FIXME comments..."
TODO_COUNT=$(git diff --cached | grep -E "^\+.*\b(TODO|FIXME)\b" | wc -l || true)
if [ $TODO_COUNT -gt 0 ]; then
    echo -e "${YELLOW}[!] Found $TODO_COUNT new TODO/FIXME comments${NC}"
    echo -e "${YELLOW}   Consider creating GitHub issues for these items${NC}"
fi

# Check for large files
echo "[>] Checking for large files..."
MAX_FILE_SIZE=1048576  # 1MB
LARGE_FILES=$(git diff --cached --name-only --diff-filter=d | while read file; do
    if [ -f "$file" ]; then
        FILE_SIZE=$(wc -c < "$file")
        if [ $FILE_SIZE -gt $MAX_FILE_SIZE ]; then
            echo "$file ($((FILE_SIZE / 1024))KB)"
        fi
    fi
done)

if [ -n "$LARGE_FILES" ]; then
    echo -e "${YELLOW}[!] Warning: Large files detected:${NC}"
    echo "$LARGE_FILES"
    echo -e "${YELLOW}   Consider if these should be added to .gitignore${NC}"
fi

# Check for leftover print() in Swift code
echo "[>] Checking for debug prints..."
DEBUG_PRINTS=$(git diff --cached | grep -E "^\+.*\bprint\(" | grep -v "Tests" || true)
if [ -n "$DEBUG_PRINTS" ]; then
    echo -e "${YELLOW}[!] Warning: Found print() statements in code${NC}"
    echo -e "${YELLOW}   Consider using Logger instead${NC}"
    echo "$DEBUG_PRINTS"
fi

# Check for NSLog usage
echo "[>] Checking for NSLog usage..."
NSLOG_USAGE=$(git diff --cached | grep -E "^\+.*NSLog\(" || true)
if [ -n "$NSLOG_USAGE" ]; then
    echo -e "${YELLOW}[!] Warning: Found NSLog usage${NC}"
    echo -e "${YELLOW}   Use os.log instead${NC}"
    echo "$NSLOG_USAGE"
fi

echo -e "${GREEN}[+] Pre-commit checks passed!${NC}"
exit 0
